# Copy to backend/.env and replace local values. Never commit backend/.env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=dermamatrix_app
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_DATABASE=dermamatrix_ai

# Optional: absolute path to a compatible TorchScript binary lesion-segmentation model.
# Without it, DermaMatrix reports an explicit model_not_configured segmentation state.
SEGMENTATION_MODEL_PATH=

# Optional affiliate URLs from an approved partner programme. Never use these for
# prescriptions, paid clinical ranking, or condition-specific treatment.
AFFILIATE_MOISTURISER_URL=
AFFILIATE_SUNSCREEN_URL=
AFFILIATE_SCALP_CLEANSER_URL=
AFFILIATE_NAIL_CARE_URL=

# Optional approved direct product pages. When both a direct page and an
# affiliate URL are supplied for one category, the approved affiliate URL is
# preferred. Empty values fall back to exact external shopping searches.
PRODUCT_MOISTURISER_URL=
PRODUCT_SUNSCREEN_URL=
PRODUCT_SCALP_CLEANSER_URL=
PRODUCT_NAIL_CARE_URL=

# Use a long random value to keep signed local sessions valid across Flask restarts.
FLASK_SECRET_KEY=replace-with-a-long-random-local-secret
# Keep false for http://127.0.0.1. Set true only behind HTTPS.
FLASK_SESSION_SECURE=false
# Signed sessions last 14 days by default (accepted range: 1–30 days).
FLASK_SESSION_DAYS=14

# `bash backend/scripts/run_local_mysql.sh` starts the isolated local instance.
# It does not use or change your system MySQL root account.
